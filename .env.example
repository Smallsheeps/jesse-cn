# Jesse dashboard password. Change this before deploying publicly.
PASSWORD=change-me

# Web dashboard port.
APP_PORT=9000
APP_HOST=0.0.0.0

# PostgreSQL settings for docker/docker-compose.yml.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_NAME=jesse_db
POSTGRES_USERNAME=jesse_user
POSTGRES_PASSWORD=password
POSTGRES_SSLMODE=disable

# Redis settings for docker/docker-compose.yml.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Optional service ports.
LSP_PORT=9001
MCP_PORT=9002

# Optional Jesse Trade token. Leave empty if you do not use Jesse Trade services.
LICENSE_API_TOKEN=

